{
  "name": "gramless",
  "version": "1.2.0",
  "description": "Ultra-fast, zero-dependency, transactional Telegram Serverless framework engineered for TGCloud",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./filters": "./src/filters.js",
    "./testkit": "./src/testkit/index.js",
    "./session": "./src/session.js",
    "./fsm": "./src/fsm.js",
    "./endpoint": "./src/endpoint.js",
    "./ratelimit": "./src/ratelimit.js",
    "./i18n": "./src/i18n.js",
    "./menu": "./src/menu.js",
    "./deeplink": "./src/deeplink.js",
    "./payments": "./src/payments.js",
    "./media-group": "./src/media_group.js",
    "./auto-retry": "./src/auto_retry.js",
    "./stateless-question": "./src/stateless_question.js",
    "./cleaner": "./src/cleaner.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bench": "node tests/bench.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "keywords": [
    "telegram",
    "serverless",
    "tgcloud",
    "bot",
    "mini-app",
    "zero-dependency",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidwiskers/gramless.git"
  },
  "bugs": {
    "url": "https://github.com/sidwiskers/gramless/issues"
  },
  "homepage": "https://github.com/sidwiskers/gramless#readme",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "author": "sidwiskers",
  "license": "MIT"
}
